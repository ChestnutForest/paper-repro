# === Anthropic ===
# Claude Code は有料プランのサインインで動くため、開発時のこのキーは
# バックエンドが LLM オーケストレーション（spec抽出・数式→コード）に使う分。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx

# === データベース ===
POSTGRES_USER=repro
POSTGRES_PASSWORD=changeme
POSTGRES_DB=paperrepro
DATABASE_URL=postgresql+psycopg://repro:changeme@localhost:5432/paperrepro

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# === アプリ設定 ===
APP_ENV=development
# API コストの上限（USD）。超えると実行を止める（要件 N-03）
COST_LIMIT_USD=5.0
# 出力zipのタイムゾーン（規約: JST）
OUTPUT_TZ=Asia/Tokyo
